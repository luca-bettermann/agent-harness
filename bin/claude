#!/bin/sh
# Launcher for claude and codex (this file's name; codex links here). Below the workspace root the clients
# miss the workspace's harness: Claude Code reads skills and hooks only from the project (git) root,
# Codex AGENTS.md and skills only from the git root down. Elsewhere the client runs unchanged.
n=$(basename "$0")
bin=$(cd "$(dirname "$0")" && pwd)
root=$(dirname "$(dirname "$bin")")
real=
IFS=:
for d in $PATH; do
  [ -x "$d/$n" ] && [ "$(cd "$d" 2>/dev/null && pwd)" != "$bin" ] && { real=$d/$n; break; }
done
unset IFS
[ -n "$real" ] || { echo "$n: not found on PATH" >&2; exit 127; }
# On Linux each session runs in its own systemd scope, so a process the kernel stops for memory stops alone:
# MemoryMax keeps the stop among the session's own processes, OOMPolicy=continue keeps the session running.
scope=
if [ "$(uname)" = Linux ]; then
  if systemd-run --user --scope -q true 2>/dev/null; then scope=1
  else echo "$n: no systemd user scope; an out-of-memory stop in this terminal ends the whole session" >&2; fi
fi
run() {
  [ -n "$scope" ] && exec systemd-run --user --scope -q -p OOMPolicy=continue -p MemoryMax=75% "$@"
  exec "$@"
}
case $n:$PWD/ in
  claude:"$root"/?*) run "$real" --add-dir "$root" --settings "$root/.claude/settings.json" "$@" ;;
  codex:"$root"/*) run "$real" -c 'project_root_markers=[".agent-harness"]' "$@" ;;
esac
run "$real" "$@"
